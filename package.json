{
  "name": "wishpage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "description": "A minimal family wishlist on Cloudflare Workers + D1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "./scripts/check-deploy.sh && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --no-include-runtime --no-include-main-module",
    "release": "npm test && npm run deploy",
    "db:local": "wrangler d1 migrations apply wishpage --local",
    "db:remote": "wrangler d1 migrations apply wishpage --remote"
  },
  "dependencies": {
    "hono": "^4.13.21"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@cloudflare/workers-types": "^5.20261124.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
