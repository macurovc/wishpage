package templates

import "wishpage/models"
import "strconv"
import "fmt"

templ View(items []models.Item, familyMembers []models.FamilyMember, selectedFamilyID int) {
	@layout("Family Wishlist", false) {
        <div class="app-header">
            <div class="d-flex align-items-center justify-content-between gap-3">
                <h1 class="m-0">
                    🎁
                    Family Wishlist
                </h1>
                <div class="d-flex align-items-center gap-3">
                    <a href="/login" class="edit-mode-toggle">
                        ✏️
                        <span>Edit</span>
                    </a>
                </div>
            </div>
        </div>

        @CollapsibleFamilySections(items, familyMembers)
	}
}

templ CollapsibleFamilySections(items []models.Item, familyMembers []models.FamilyMember) {
    if len(familyMembers) == 0 {
        <div class="empty-state">
            👥
            <h3>No family members yet</h3>
            <p>Add family members in edit mode to get started</p>
        </div>
    } else {
        for _, member := range familyMembers {
            <details class="family-section">
                <summary class="family-section-header">
                    <div class="family-section-title">
                        <span class="family-icon">👤</span>
                        <h3>{ member.Name }</h3>
                    </div>
                    <span class="item-count">{ strconv.Itoa(countItemsForMember(items, member.ID)) } items</span>
                </summary>
                <div class="family-section-content">
                    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
                        if !hasItemsForMember(items, member.ID) {
                            <div class="col-12">
                                <div class="empty-state-small">
                                    🎁 No items yet for { member.Name }
                                </div>
                            </div>
                        }
                        for _, item := range items {
                            if item.FamilyMemberID == member.ID {
                                @ItemCardView(item, familyMembers)
                            }
                        }
                    </div>
                </div>
            </details>
        }
    }
}

templ ItemCardView(item models.Item, familyMembers []models.FamilyMember) {
    <div class="col">
        <div class={ "card h-100", templ.KV("reserved-item", item.Reserved) } data-item-id={ strconv.Itoa(item.ID) }>
            <div class="card-body">
                <h5 class="card-title mb-3">
                    if item.Reserved {
                        <del>{ item.Name }</del>
                    } else {
                        { item.Name }
                    }
                </h5>
                
                if item.Price != nil {
                    <div class="price-tag mb-3">
                        €
                        { fmt.Sprintf("%.2f", *item.Price) }
                    </div>
                }
                
                if item.Link != nil && *item.Link != "" {
                    <a href={ templ.SafeURL(*item.Link) } class="card-link mb-3 d-inline-flex" target="_blank">
                        🔗
                        View Item
                    </a>
                }

                <div class="d-flex flex-wrap align-items-center gap-2 mt-auto">
                    if item.Reserved {
                        <span class="reserved-badge">Reserved</span>
                    } else {
                        @ReserveControls(item.ID)
                    }
                </div>
            </div>
        </div>
    </div>
}

templ ReserveControls(itemID int) {
    <details class="reserve-dropdown">
        <summary class="btn btn-primary btn-sm">
            <span>✓ Reserve</span>
        </summary>
        <div class="reserve-confirmation">
            <p class="mb-2">Reserve this item?</p>
            <div class="d-flex gap-2">
                <button class="btn btn-success btn-sm" 
                        hx-put={ "/api/items/" + strconv.Itoa(itemID) + "/reserve" }
                        hx-target="closest .col"
                        hx-swap="outerHTML">
                    ✓ Confirm
                </button>
            </div>
        </div>
    </details>
}

templ ItemListView(items []models.Item, familyMembers []models.FamilyMember) {
    if len(items) == 0 {
        <div class="col-12">
            <div class="empty-state">
                👆
                <h3>Select a family member above</h3>
            </div>
        </div>
    }
    for _, item := range items {
        @ItemCardView(item, familyMembers)
    }
}

// Helper function to check if member has any items
func hasItemsForMember(items []models.Item, memberID int) bool {
    for _, item := range items {
        if item.FamilyMemberID == memberID {
            return true
        }
    }
    return false
}

// Helper function to count items for a member
func countItemsForMember(items []models.Item, memberID int) int {
    count := 0
    for _, item := range items {
        if item.FamilyMemberID == memberID {
            count++
        }
    }
    return count
}
