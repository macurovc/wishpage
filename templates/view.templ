package templates

import "wishpage/models"
import "strconv"
import "fmt"

templ View(items []models.Item, familyMembers []models.FamilyMember, selectedFamilyID int) {
	@layout("Family Wishlist", false) {
        <div class="app-header">
            <div class="d-flex align-items-center justify-content-between gap-3">
                <h1 class="m-0">
                    🎁
                    Family Wishlist
                </h1>
                <div class="d-flex align-items-center gap-3">
                    <a href="/login" class="edit-mode-toggle">
                        ✏️
                        <span>Edit</span>
                    </a>
                </div>
            </div>
        </div>

        @FamilyMemberListView(familyMembers, selectedFamilyID)

        <div id="item-list" class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @ItemListView(items, familyMembers)
        </div>
	}
}

templ FamilyMemberListView(members []models.FamilyMember, selectedFamilyID int) {
    <div id="family-member-list" class="sticky-tabs">
        if len(members) == 0 {
            <div class="empty-state">
                👥
                <h3>No family members yet</h3>
            </div>
        }
        <nav class="tabs-scroll">
            <div class="nav nav-pills" id="family-tabs" role="tablist">
                for _, member := range members {
                    <div class="d-flex align-items-center me-2">
                        <a class={ "nav-link", templ.KV("active", member.ID == selectedFamilyID) } href={ templ.URL("/family/" + member.Name) }>
                            { member.Name }
                        </a>
                    </div>
                }
            </div>
        </nav>
    </div>
}

templ ItemListView(items []models.Item, familyMembers []models.FamilyMember) {
    if len(items) == 0 {
        <div class="col-12">
            <div class="empty-state">
                👆
                <h3>Select a family member above</h3>
            </div>
        </div>
    }
    for _, item := range items {
        @itemCardView(item, familyMembers)
    }
}

templ itemCardView(item models.Item, familyMembers []models.FamilyMember) {
    <div class="col">
        <div class={ "card h-100", templ.KV("reserved-item", item.Reserved) } data-item-id={ strconv.Itoa(item.ID) }>
            <div class="card-body">
                <h5 class="card-title mb-3">
                    if item.Reserved {
                        <del>{ item.Name }</del>
                    } else {
                        { item.Name }
                    }
                </h5>
                
                if item.Price != nil {
                    <div class="price-tag mb-3">
                        €
                        { fmt.Sprintf("%.2f", *item.Price) }
                    </div>
                }
                
                if item.Link != nil && *item.Link != "" {
                    <a href={ templ.SafeURL(*item.Link) } class="card-link mb-3 d-inline-flex" target="_blank">
                        🔗
                        View Item
                    </a>
                }

                <div class="d-flex flex-wrap align-items-center gap-2 mt-auto">
                    if item.Reserved {
                        <span class="reserved-badge">Reserved</span>
                    } else {
                        <div id={ "reserve-controls-" + strconv.Itoa(item.ID) }>
                            @ReserveButton(item.ID)
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

templ ReserveButton(itemID int) {
    <button class="btn btn-primary btn-sm" 
            hx-get={ "/api/items/" + strconv.Itoa(itemID) + "/reserve-confirm" }
            hx-target={ "#reserve-controls-" + strconv.Itoa(itemID) }
            hx-swap="innerHTML">
        ✓
        Reserve
    </button>
}

templ ReserveConfirmation(itemID int) {
    <div class="d-flex gap-2">
        <button class="btn btn-secondary btn-sm" 
                hx-get={ "/api/items/" + strconv.Itoa(itemID) + "/reserve-cancel" }
                hx-target={ "#reserve-controls-" + strconv.Itoa(itemID) }
                hx-swap="innerHTML">
            ✗
            Cancel
        </button>
        <button class="btn btn-success btn-sm" 
                hx-put={ "/api/items/" + strconv.Itoa(itemID) + "/reserve" }
                hx-target="#item-list">
            ✓
            Confirm
        </button>
    </div>
}

