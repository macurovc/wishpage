package templates

templ Login(errorMsg string) {
	@layout("Login - Family Wishlist", false) {
		<div class="login-page">
			<div class="login-container">
				<div class="login-header">
					<h1>🎁 Family Wishlist</h1>
					<p class="login-subtitle">Enter password to edit</p>
				</div>

				if errorMsg != "" {
					<div class="alert alert-danger" role="alert">
						if errorMsg == "password" {
							❌ Incorrect password. Please try again.
						} else if errorMsg == "config" {
							⚠️ Password not configured. Please contact the administrator.
						} else {
							❌ An error occurred. Please try again.
						}
					</div>
				}

				<form action="/api/login" method="POST" class="login-form" autocomplete="on">
					<div class="mb-3">
						<label for="password" class="form-label">Password</label>
						<input 
							type="password" 
							class="form-control form-control-lg" 
							id="password" 
							name="password" 
							placeholder="Enter password" 
							autocomplete="current-password" 
							autofocus
							required
						/>
					</div>
					<div class="d-grid mb-3">
						<button type="submit" class="btn btn-primary btn-lg">
							🔓 Start Editing
						</button>
					</div>
					<div class="text-center">
						<a href="/" class="back-link">← Back to wishlist</a>
					</div>
				</form>
			</div>
		</div>
	}
}

